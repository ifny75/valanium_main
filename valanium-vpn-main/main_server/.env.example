# Copy to .env; generate new values locally before deployment.
DATABASE_URL=sqlite+aiosqlite:///./obsyxgen.db
SECRET_KEY=replace-with-a-new-random-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-unique-admin-password
ACCESS_CODE_PEPPER_FILE=./access_code_pepper
ACCESS_TOKEN_EXPIRE_MINUTES=60
DEVICE_TOKEN_EXPIRE_MINUTES=60
COOKIE_SECURE=true
