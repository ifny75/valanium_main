{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Valanium VPN",
  "version": "0.1.0",
  "identifier": "com.valanium.vpn",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Valanium VPN",
        "width": 950,
        "height": 560,
        "minWidth": 800,
        "minHeight": 480,
        "resizable": true,
        "center": true,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": ["bin/wireguard.dll"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
