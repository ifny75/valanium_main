<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/entry_content" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_horizontal" android:orientation="vertical" android:paddingTop="28dp" android:paddingBottom="30dp">
            <ImageView android:id="@+id/entry_logo" android:layout_width="88dp" android:layout_height="88dp" android:background="@drawable/entry_badge" android:contentDescription="@string/app_name" android:padding="15dp" android:src="@drawable/valanium_logo" />
            <TextView android:id="@+id/entry_wordmark" style="@style/Valanium.Wordmark" android:layout_marginTop="14dp" android:text="@string/app_name" android:textSize="30sp" />
            <TextView android:id="@+id/entry_badge" style="@style/Valanium.Micro" android:layout_marginTop="9dp" android:background="@drawable/entry_badge" android:gravity="center" android:letterSpacing="0.12" android:paddingStart="12dp" android:paddingTop="7dp" android:paddingEnd="12dp" android:paddingBottom="7dp" android:text="@string/entry_eyebrow" android:textColor="#BE9EFF" android:textSize="10sp" />
            <LinearLayout android:id="@+id/entry_form" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:background="@drawable/entry_surface" android:orientation="vertical" android:padding="22dp">
                <TextView style="@style/Valanium.Title" android:text="@string/registration_title" android:textSize="25sp" />
                <TextView style="@style/Valanium.Muted" android:layout_marginTop="7dp" android:text="@string/entry_lead" android:textSize="14sp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:orientation="horizontal" android:weightSum="3"><TextView style="@style/Valanium.Micro" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/entry_notice" android:gravity="center" android:padding="9dp" android:text="@string/entry_benefit_phone" /><TextView style="@style/Valanium.Micro" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="6dp" android:layout_weight="1" android:background="@drawable/entry_notice" android:gravity="center" android:padding="9dp" android:text="@string/entry_benefit_keys" /><TextView style="@style/Valanium.Micro" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="6dp" android:layout_weight="1" android:background="@drawable/entry_notice" android:gravity="center" android:padding="9dp" android:text="@string/entry_benefit_contacts" /></LinearLayout>

                <EditText android:id="@+id/invite" style="@style/Valanium.Input" android:layout_marginTop="10dp" android:autofillHints="" android:background="@drawable/entry_input" android:hint="@string/invite" android:inputType="textNoSuggestions" />
                <LinearLayout android:id="@+id/entry_tor_row" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="15dp" android:background="@drawable/entry_notice" android:gravity="center_vertical" android:orientation="horizontal" android:padding="12dp"><ImageView android:layout_width="30dp" android:layout_height="30dp" android:contentDescription="@null" android:src="@drawable/routing_tor" android:tint="@color/valanium_white" /><LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="11dp" android:layout_weight="1" android:orientation="vertical"><TextView style="@style/Valanium.SettingTitle" android:text="@string/entry_tor_title" android:textSize="14sp"/><TextView style="@style/Valanium.Micro" android:layout_marginTop="2dp" android:text="@string/entry_tor_hint" /></LinearLayout><Switch android:id="@+id/entry_tor_only" android:layout_width="wrap_content" android:layout_height="48dp" android:checked="true" android:contentDescription="@string/entry_tor_title" android:showText="false" /></LinearLayout>
                <Button android:id="@+id/entry_submit" style="@style/Valanium.Button.Primary" android:layout_marginTop="14dp" android:background="@drawable/entry_primary" android:text="@string/register" android:textColor="@color/valanium_white" />
                <TextView style="@style/Valanium.Micro" android:layout_marginTop="8dp" android:gravity="center" android:text="@string/entry_action_hint" />
                <Button android:id="@+id/open_recover" style="@style/Valanium.Button.Link" android:layout_marginTop="4dp" android:text="@string/recover_open" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="13dp" android:background="@drawable/entry_notice" android:gravity="center_vertical" android:orientation="horizontal" android:padding="14dp"><ImageView android:layout_width="24dp" android:layout_height="24dp" android:contentDescription="@null" android:src="@drawable/ic_lock" android:tint="#BE9EFF"/><TextView android:id="@+id/entry_footer" style="@style/Valanium.Micro" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="11dp" android:layout_weight="1" android:text="@string/entry_footer" /></LinearLayout>
            <TextView style="@style/Valanium.Micro" android:layout_marginTop="12dp" android:gravity="center" android:text="@string/server_fixed_hint" />
        </LinearLayout>
